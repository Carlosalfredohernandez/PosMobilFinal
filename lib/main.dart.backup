        ),
        
        // Rutas placeholder para compatibilidad
        GetPage(name: '/menu_general/usuarios', page: () => const Placeholder()),
        GetPage(name: '/menu_general/productos', page: () => const Placeholder()),
        GetPage(name: '/menu_general/informes_ventas', page: () => const Placeholder()),
        GetPage(name: '/menu_general/estadisticas', page: () => const Placeholder()),
        GetPage(name: '/menu_general/inventarios', page: () => const Placeholder()),
        GetPage(name: '/registro', page: () => const Placeholder()),
