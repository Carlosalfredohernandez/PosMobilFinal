      ),
      
      // 🔧 CONFIGURACIONES ADICIONALES
      navigatorKey: Get.key,
      
      // Configuraciones de GetX
      defaultTransition: Transition.rightToLeft,
      transitionDuration: const Duration(milliseconds: 300),
      
      // Configuración de idioma
      locale: const Locale('es', 'CL'),
      fallbackLocale: const Locale('es', 'CL'),
      
      // Builder para manejo global de errores
      builder: (context, child) {
        return MediaQuery(
          data: MediaQuery.of(context).copyWith(textScaleFactor: 1.0),
          child: child!,
        );
      },
    );
  }

  // 🔐 FUNCIÓN PARA DETERMINAR RUTA INICIAL SEGÚN AUTENTICACIÓN
  String _obtenerRutaInicial() {
    final storage = GetStorage();
    final empresaData = storage.read('empresa_data');
    final usuarioEmpresa = storage.read('usuario_empresa');
    final usuarioRol = storage.read('usuario_rol');
    
    print('🔍 Verificando sesión guardada...');
    print('  🏢 Empresa: ${empresaData != null}');
    print('  👤 Usuario: ${usuarioEmpresa != null}');
    print('  🎯 Rol: $usuarioRol');
    
    // ✅ LÓGICA CORREGIDA: Solo navegar automáticamente si hay sesión COMPLETA
    // Si hay sesión completa (empresa + usuario + rol), navegar según rol
    if (empresaData != null && usuarioEmpresa != null && usuarioRol != null) {
      switch (usuarioRol) {
        case 1: // Administrador
          print('🔑 → Menú completo (Administrador)');
          return '/menu_inicio';
          
        case 3: // Cajero
          print('🛒 → Menú de cajero (solo acceso a caja)');
          return '/menu_inicio'; // También va al menú, pero se filtra en MenuInicioPageControlado
          
        default:
          print('⚠️ → Login (Rol desconocido)');
          return '/login'; // ✅ AUTO-NAVEGACIÓN DESHABILITADA - LOGIN SIMPLE
      }
    }
    
    // Si no hay sesión completa, ir al login empresarial
    print('🔐 → Login unificado (sesión incompleta o inexistente)');
    return '/login'; // ✅ RUTA POR DEFECTO - LOGIN SIMPLE RESTAURADO
  }
}