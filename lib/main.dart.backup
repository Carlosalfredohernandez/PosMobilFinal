        GetPage(name: '/inicio/cliente/mantenedorlistadorusuarios', page: () => const Placeholder()),
        GetPage(name: '/inicio/cliente/productos/crear', page: () => const Placeholder()),
        GetPage(name: '/home', page: () => const Placeholder()),
        GetPage(name: '/inicio/cliente/agregar/producto', page: () => const Placeholder()),
        GetPage(name: '/inicio/cliente/perfil/editar', page: () => const Placeholder()),
        GetPage(name: '/inicio/cliente/perfil/lista', page: () => const Placeholder()),
        GetPage(name: '/inicio/cliente/productos/editar', page: () => const Placeholder()),
        GetPage(name: '/mantenedores/menu', page: () => const Placeholder()),
        GetPage(name: '/mantenedores/productos', page: () => const Placeholder()),
        GetPage(name: '/mantenedores/maestros/busqueda', page: () => const Placeholder()),
        GetPage(name: '/mantenedores/maestros/usuarios', page: () => const Placeholder()),
        GetPage(name: '/mantenedores/local', page: () => const Placeholder()),
        GetPage(name: '/mantenedores/proveedor', page: () => const Placeholder()),
        GetPage(name: '/informes/ventas', page: () => const Placeholder()),
        GetPage(name: '/inventarios/menu', page: () => const Placeholder()),
        GetPage(name: '/inventarios/vista', page: () => const Placeholder()),
        GetPage(name: '/inventarios/create', page: () => const Placeholder()),
        GetPage(name: '/inventarios/informes', page: () => const Placeholder()),
        GetPage(name: '/configuraciones/impresora', page: () => const Placeholder()),
        GetPage(name: '/agregar', page: () => const Placeholder()),
        GetPage(name: '/informes/estadisticas', page: () => const Placeholder()),
      ],
      
